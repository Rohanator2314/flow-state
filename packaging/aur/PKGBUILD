# Maintainer: Rohan S <rohans2314@gmail.com>

pkgname=flow-state
pkgver=0.1.45
pkgrel=1
pkgdesc='Focus-first desktop editor for Markdown, LaTeX, and plain text'
arch=('x86_64')
url='https://github.com/Rohanator2314/flow-state'
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=(
  'hunspell-en_us: US English dictionary for spell checking'
  'texlive-latex: compile the LaTeX preview (pdflatex/xelatex)'
  'poppler: render the compiled PDF into the preview pane (pdftoppm)'
)
options=('!lto')
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  'flow-state.desktop'
  'io.github.rohanator2314.flow-state.metainfo.xml'
  'flow-state-icon.png'
)
sha256sums=(
  '376d0c4918cfc62e5a8cfb32cd22b2fcb47f5c70fff8df065f556d21e72ad6e0'
  '8b44feecd3cfd3dee9f825811e2fab13c64c3e7c4d89a2f3c555ffe7444b8e35'
  '823f49a61af685389e785ae0eec46f314e6d6ff1e90e2f7d6fcf710d83d0bc0b'
  '68aa49d6b03a135ed26ce324a8709a185e9b56ba78edf07f335e233ae96ede97'
)

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --all-features -- --skip core::latex::tests
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  ln -s flow-state "$pkgdir/usr/bin/fs"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/flow-state.desktop" \
    "$pkgdir/usr/share/applications/flow-state.desktop"
  install -Dm644 "$srcdir/flow-state-icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/flow-state.png"
  install -Dm644 \
    "$srcdir/io.github.rohanator2314.flow-state.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.rohanator2314.flow-state.metainfo.xml"

  if compgen -G "themes/*.toml" >/dev/null; then
    install -Dm644 -t "$pkgdir/usr/share/$pkgname/themes" themes/*.toml
  fi
}
